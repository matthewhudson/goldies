  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "javascript",
    "library",
    "utilities",
    "functions"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "docs:generate": "typedoc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "husky install",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/smoke-test.mjs && tsc -p scripts/types/tsconfig.json && tsc -p scripts/types/tsconfig.browser.json && publint && attw --pack . --profile node16 --ignore-rules false-export-default",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "validate": "npm run lint && npm run test && npm run build && npm run test:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "author": {
    "name": "Matthew Hudson",
    "email": "matthud@gmail.com",
    "url": "https://hudson.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.0.11",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "tmp": "^0.2.3",
    "tsdown": "0.23.2",
    "typedoc": "^0.28.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewhudson/goldies.git"
  }
}
